[Unit]
Description=statefalse API
After=network.target

[Service]
Type=simple
User=statefalse
Group=statefalse
WorkingDirectory=/opt/statefalse/current
ExecStart=/opt/statefalse/current/Statefalse.Api
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/log/statefalse
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
LimitNOFILE=4096
TasksMax=256
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000;http://172.18.0.1:5000
Environment=STATEFALSE_LOG_DIRECTORY=/var/log/statefalse
EnvironmentFile=/etc/statefalse/statefalse.env

[Install]
WantedBy=multi-user.target
