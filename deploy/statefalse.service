[Unit]
Description=statefalse API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/statefalse
ExecStart=/opt/statefalse/Statefalse.Api
Restart=always
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
EnvironmentFile=/etc/statefalse/statefalse.env

[Install]
WantedBy=multi-user.target
