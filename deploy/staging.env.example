# Staging only. Never copy production values here.
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://127.0.0.1:5100
ConnectionStrings__DefaultConnection=Data Source=/var/lib/statefalse-staging/statefalse.db
GitHubOAuth__ClientId=STAGING_GITHUB_CLIENT_ID
GitHubOAuth__ClientSecret=STAGING_GITHUB_CLIENT_SECRET
GitHubOAuth__RedirectUri=https://api-staging.statefalse.com/api/auth/callback
WebhookSecret=STAGING_WEBHOOK_SECRET
Jwt__Secret=GENERATE_A_UNIQUE_64_BYTE_STAGING_SECRET
Cors__AllowedOrigins__0=https://staging.statefalse.com

