# Copy to deploy/statefalse.env (gitignored) and fill with real values.
# deploy.sh uploads it to /etc/statefalse/statefalse.env on the VPS (root, mode 600).
# Generate secrets with: openssl rand -hex 32
# Production API: https://api.statefalse.com
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=statefalse;Username=statefalse;Password=CHANGE_ME
WebhookSecret=CHANGE_ME
GitHubOAuth__ClientId=CHANGE_ME
GitHubOAuth__ClientSecret=CHANGE_ME
GitHubOAuth__RedirectUri=https://api.statefalse.com/api/auth/callback
Jwt__Secret=CHANGE_ME
Jwt__RefreshTokenAbsoluteLifetimeDays=90
GitHubCredentials__EncryptionKey=CHANGE_ME_BASE64_256_BIT_KEY
GitHubCredentials__ActiveKeyId=2026-08
GitHubCredentials__ActiveKey=CHANGE_ME_BASE64_256_BIT_KEY
# Keep PreviousKeyId and PreviousKey during a rotation until re-encryption is verified.
# GitHubCredentials__PreviousKeyId=
# GitHubCredentials__PreviousKey=
Backup__EncryptionKey=CHANGE_ME_BASE64_256_BIT_KEY
WebhookLogs__AdminGitHubIds__0=YOUR_GITHUB_ID
