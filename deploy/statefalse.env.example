# Copy to deploy/statefalse.env (gitignored) and fill with real values.
# deploy.sh uploads it to /etc/statefalse/statefalse.env on the VPS (root, mode 600).
# Generate secrets with: openssl rand -hex 32
WebhookSecret=CHANGE_ME
GitHubOAuth__ClientId=CHANGE_ME
GitHubOAuth__ClientSecret=CHANGE_ME
GitHubOAuth__RedirectUri=https://CHANGE_ME.ngrok-free.dev/api/auth/callback
Jwt__Secret=CHANGE_ME
