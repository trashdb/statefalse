{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;api.statefalse.com",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Api": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Oauth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Action": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Webhook": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "RetryAfterSeconds": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/var/lib/statefalse/statefalse.db"
  },
  "GitHubOAuth": {
    "ClientId": "YOUR_GITHUB_CLIENT_ID",
    "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET",
    "RedirectUri": "https://api.statefalse.com/api/auth/callback"
  },
  "WebhookSecret": "set-your-github-webhook-secret-here",
  "WebhookLogs": {
    "AdminGitHubIds": []
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "statefalse",
    "Audience": "statefalse-native",
    "ExpiryHours": 1,
    "RefreshTokenExpiryDays": 30
  }
}
