{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;api.statefalse.com;api-staging.statefalse.com",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/var/lib/statefalse/statefalse.db"
  },
  "GitHubOAuth": {
    "ClientId": "YOUR_GITHUB_CLIENT_ID",
    "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET",
    "RedirectUri": "https://api.statefalse.com/api/auth/callback"
  },
  "WebhookSecret": "set-your-github-webhook-secret-here",
  "Jwt": {
    "Secret": "",
    "Issuer": "statefalse",
    "Audience": "statefalse-native",
    "ExpiryHours": 720
  }
}
